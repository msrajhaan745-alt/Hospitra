# Optional Hospitra settings (read from the process environment; no .env loader is used).
# PowerShell example:  $env:HOSPITRA_DATABASE_URL = "sqlite:///C:/temp/hospitra.db"

# SQLite database URL. Default: sqlite:///<project>/backend/data/hospitra.db
HOSPITRA_DATABASE_URL=

# Informational defaults; the bind address is set on the uvicorn command line. Keep 127.0.0.1.
HOSPITRA_HOST=127.0.0.1
HOSPITRA_PORT=8000

# ---- V2 authentication ----
# Absolute session lifetime in hours (default 8).
HOSPITRA_SESSION_HOURS=8
# Set to true when serving over HTTPS so the session cookie is only sent over TLS.
HOSPITRA_COOKIE_SECURE=false
# PBKDF2-SHA256 work factor for new password hashes (default 600000; tests use a low value).
HOSPITRA_PBKDF2_ITERATIONS=600000
